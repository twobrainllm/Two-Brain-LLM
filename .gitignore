# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Tooling caches
.ruff_cache/
.mypy_cache/

# Secrets -- never commit
.env

# NPU deployment work (superpowers/deploy-local-brain-npu.md)
# Dedicated ARM64 runtime venv -- keep separate from the router's own
# stdlib-only .venv (see run.ps1); not vendored.
.venv-npu/
# Model artifacts are large binaries fetched from public URLs, not vendored --
# the _real_*_log.md receipt in each data/npu_model/<model>/ dir documents
# exactly what was downloaded, from where, and with what checksum, so the
# fetch is reproducible without committing gigabytes of weights.
data/npu_model/**/raw/
data/npu_model/**/*.zip
data/npu_model/**/*.bin
data/npu_model/**/*.dll
data/npu_model/**/*.so
data/npu_model/**/*.cat
data/npu_model/**/*.onnx
data/npu_model/**/*.gguf

# GenieX experiment venv (source-only sdist, auto-provisions a native SDK)
.venv-geniex/

# GPU (Adreno/OpenCL) VLM work -- same rationale as the NPU section above.
# Pre-built llama.cpp OpenCL binary + a copy of the Adreno driver package
# (needed for the no-admin-rights OCL_ICD_FILENAMES workaround -- see
# data/vlm_gpu_model/*/_real_inference_smoke_log.md); not vendored.
.llama-cpp-opencl/
data/vlm_gpu_model/**/raw/
data/vlm_gpu_model/**/*.gguf
